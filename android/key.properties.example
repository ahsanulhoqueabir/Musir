# Copy to android/key.properties (git-ignored) and fill in.
# Create a keystore with:
#   keytool -genkey -v -keystore ~/musir-upload.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias upload
storePassword=<keystore password>
keyPassword=<key password>
keyAlias=upload
storeFile=/absolute/path/to/musir-upload.jks
